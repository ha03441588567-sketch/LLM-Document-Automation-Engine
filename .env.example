# Which extraction model to use: "donut" or "layoutlm"
EXTRACTOR_MODEL=donut

# Hugging Face model checkpoints (override if you fine-tune your own)
DONUT_MODEL_ID=naver-clova-ix/donut-base-finetuned-cord-v2
LAYOUTLM_MODEL_ID=microsoft/layoutlmv3-base

# Device: "cpu" or "cuda"
DEVICE=cpu

# Downstream automation webhook — extracted JSON is POSTed here after every
# successful extraction. Point at Zapier / Make.com / n8n / your ERP API.
WORKFLOW_WEBHOOK_URL=

# Max upload size in MB
MAX_UPLOAD_MB=15
